# ┌──────────────────────────────────────────────────────────────┐
# │ 이 파일을 복사해서 .env.local 을 만드세요.                    │
# │ 윈도우 PowerShell:  Copy-Item .env.example .env.local        │
# │ .env.local 은 절대 GitHub에 올라가지 않습니다(.gitignore 등록)│
# └──────────────────────────────────────────────────────────────┘

# Supabase 프로젝트 설정 > API Keys 에서 복사
# 이 두 개가 전부입니다. 규민에게 개인톡으로 받으세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 로그인 후 돌아올 주소는 따로 적지 않습니다.
# 코드가 window.location.origin 으로 "지금 접속한 주소"를 실행 중에 알아내기 때문에
# localhost:3000 이든 3001 이든 배포 주소든 알아서 맞습니다.
# 대신 그 주소가 Supabase > Authentication > URL Configuration 의
# Redirect URLs 목록에 등록되어 있어야 합니다.
